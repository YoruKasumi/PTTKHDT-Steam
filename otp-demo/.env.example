# Cổng server Express
PORT=3000

# SMTP giả lập (MailDev). Bo trong SMTP_HOST neu chua cai MailDev:
# khi do ma OTP se duoc in ra console cua server de van test duoc flow.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025

# Dia chi nguoi gui hien thi trong mail
MAIL_FROM=Demo OTP <no-reply@demo.local>

# (Tuy chon) Neu dat bien nay, OTP duoc bam bang HMAC-SHA256 voi khoa rieng
# thay vi SHA-256 thuan - an toan hon neu ke xau doc duoc bo nho server.
# OTP_SECRET=thay-chuoi-ngau-nhien-vao-day
