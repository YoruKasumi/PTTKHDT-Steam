# Dependencies
node_modules/

# Build output and test coverage
dist/
build/
coverage/

# Local environment and secrets (keep example templates versioned)
.env
.env.*
!.env.example
!.env.*.example

# Logs and temporary files
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
*.tmp
*.temp

# Local application storage and generated uploads
backend/storage/uploads/*
!backend/storage/uploads/.gitkeep
backend/storage/builds/*
!backend/storage/builds/.gitkeep

# OS files
.DS_Store
Thumbs.db
Desktop.ini
