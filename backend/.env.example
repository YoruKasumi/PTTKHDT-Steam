# Máy chủ
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# MySQL (xem sql/steam_store_schema.sql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=steam_store
DB_POOL_SIZE=10

# JWT
JWT_SECRET=doi-chuoi-bi-mat-nay
JWT_EXPIRES_IN=2h

# Lưu trữ file game / ảnh: local (mặc định) hoặc r2 (Cloudflare R2, tương thích S3)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Quy tắc nghiệp vụ (theo sơ đồ sequence / sơ đồ trạng thái)
REFUND_WINDOW_HOURS=24
MAX_KEYS_PER_BATCH=200
MAX_UNUSED_KEYS_PER_GAME=2000

# Cấu hình SMTP gửi OTP
# [1] Môi trường DEV (Dùng MailDev chạy local: npm run maildev):
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Vortex Gaming <no-reply@vortex.local>
# [2] Môi trường Production (Google SMTP hoặc máy chủ mail thật):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=Vortex Gaming <no-reply@vortex.local>
