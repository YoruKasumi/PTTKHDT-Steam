{
  "name": "steam-store-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Steam Store - Backend 3 tầng (Route/Service/DAO) với MySQL",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test",
    "db:schema": "mysql -u root -p < sql/steam_store_schema.sql",
    "db:extra": "mysql -u root -p < sql/extra_tables.sql",
    "db:sample": "mysql -u root -p < sql/steam_store_sample_data.sql",
    "db:bootstrap-admin": "node scripts/bootstrap-admin.js",
    "db:bootstrap-demo": "node scripts/bootstrap-demo-accounts.js",
    "db:seed-demo": "node scripts/seed-demo-store.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.9.7",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
